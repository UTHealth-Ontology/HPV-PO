                    </rdf:Description>
                </owl:oneOf>
            </rdfs:Datatype>
        </owl:equivalentClass>
    </rdfs:Datatype>
    


    <!-- http://purl.org/uth/ontology/hpv-po.owl#SeverityLevel -->

